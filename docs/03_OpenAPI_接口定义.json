  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "default": ""
          },
          "interface": {
            "type": "string",
            "title": "Interface",
            "default": "any"
          },
          "shutter": {
            "type": "string",
            "title": "Shutter",
            "default": "any"
          },
          "os": {
            "type": "string",
            "title": "Os",
            "default": "any"
          },
          "arch": {
            "type": "string",
            "title": "Arch",
            "default": "any"
          },
          "min_mp": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Min Mp",
            "default": 0
          },
          "min_fps": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Min Fps",
            "default": 0
          },
          "max_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Price"
          },
          "qty": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Qty",
            "default": 1
          }
        },
        "type": "object",
        "title": "MatchRequest"
      },
      "RFQ": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "requirements": {
            "additionalProperties": true,
            "type": "object",
            "title": "Requirements"
          },
          "qty": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Qty"
          },
          "destination": {
            "type": "string",
            "maxLength": 150,
            "minLength": 2,
            "title": "Destination"
          },
          "notes": {
            "type": "string",
            "maxLength": 3000,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "sku",
          "requirements",
          "qty",
          "destination"
        ],
        "title": "RFQ"
      },
      "RequirementText": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "RequirementText"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
